{
  "name": "@trunk/api",
  "version": "1.0.0",
  "description": "Trunk API — Fastify backend service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "imports": {
    "#app": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#core/*": {
      "types": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#features/*": {
      "types": "./src/features/*.ts",
      "default": "./dist/features/*.js"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@trunk/contracts": "*",
    "fastify": "^5.12.3",
    "zod": "^4.5.4"
  }
}
